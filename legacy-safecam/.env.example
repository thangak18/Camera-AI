POSTGRES_DB=safecam
POSTGRES_USER=safecam
POSTGRES_PASSWORD=safecam
POSTGRES_PORT=5432

# Mac dinh app dung PostgreSQL local trong Docker Compose.
# Neu muon dung Supabase PostgreSQL, bo comment dong duoi va thay bang URI cua Supabase.
# DATABASE_URL=postgresql+psycopg://postgres:<password>@<host>:5432/postgres

API_PORT=8000
WEB_PORT=8080
CLIP_SECONDS=10
EMBEDDING_DIM=384
MAX_UPLOAD_MB=512
