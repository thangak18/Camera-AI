# Copy file nay thanh `.env` roi dien key that. `.env` da nam trong .gitignore.
#
#   cp .env.example .env        (Git Bash)
#   copy .env.example .env      (cmd / PowerShell)
#
# Kiem lai bang:  python scripts/preflight.py

# ---------------------------------------------------------------------------
# Gemini - BAT BUOC
# ---------------------------------------------------------------------------
# Dung cho ca ba khau: dich query Viet->Anh cho SigLIP, Stage B rerank, va VLM
# tra loi Dang 2. Thieu key thi Dang 2 ra 'khong ro' 100% va query khong duoc
# dich (SigLIP yeu tieng Viet tho).
GEMINI_API_KEY=

# Key du phong. client.py chuyen key khi gap 401 (key chet) hoac 429 (can
# quota) - KHONG xoay moi request, do la hanh vi cu da go vi vi pham ToS.
# Luu y: 503 la Google qua tai, KHONG phai loi quota, nen them key khong cuu
# duoc ca do. Doc toi GEMINI_KEY_10.
GEMINI_KEY_2=
GEMINI_KEY_3=

# ---------------------------------------------------------------------------
# Qdrant - TUY CHON.
#
# config.py da co san gia tri mac dinh tro toi Qdrant Cloud cua nhom, va no
# dang chay duoc (preflight doc du 177.321 diem). Bo comment + dien vao day
# neu ban dung instance khac, hoac key da duoc xoay - gia tri o day LUON duoc
# uu tien hon mac dinh trong config.py.
# ---------------------------------------------------------------------------
# QDRANT_URL=
# QDRANT_API_KEY=

# ---------------------------------------------------------------------------
# Cong tac nhanh khi co su co - khong can sua code
# ---------------------------------------------------------------------------
# Gemini dang 503 hang loat / muon chay nhanh: tat Stage B.
# AIC_RERANK_STAGE_B=0

# Vong thi TRUC TIEP bi bam gio (BTC: Dang 1&3 < 3s, Dang 2 < 10s).
# Mot bien duy nhat doi ca bo ngan sach: call 25s->2.5s, QA 300s->8s,
# hoi HET nhom -> 5 nhom, va tat Stage B (7-11s/truy van thi khong lot noi).
# Mac dinh la "offline" - dung cho sinh bai nop.
# AIC_PROFILE=live

# Chay qua localtunnel ma request Dang 2 bi ngat giua chung:
# AIC_QA_DEADLINE=90

# Circuit breaker nhay/cham qua (mac dinh: 6 loi lien tiep -> nghi 30s).
# AIC_GEMINI_BREAKER_FAILS=6
# AIC_GEMINI_BREAKER_COOLDOWN=30

# Cache model HuggingFace (SigLIP ~1.5GB). Doi neu o dia C khong con cho.
# HF_HOME=D:/AIC/hf_cache
